# ── fe-ppe: mẫu cấu hình môi trường ──
# Sao chép file này thành .env.local và điền giá trị thực tế.

# Base URL qua Traefik Gateway (mọi microservice đi qua 1 cổng, cookie cùng origin)
NEXT_PUBLIC_API_BASE_URL=http://localhost:80/api/v1

# Dev trực tiếp identity-service (fallback khi chưa chạy Traefik)
NEXT_PUBLIC_IDENTITY_URL=http://localhost:9999/api/v1

# URL frontend (dùng cho redirectUri social login, link email)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile site key (public) — widget captcha trên register/forgot/resend.
# Lấy tại Cloudflare Dashboard → Turnstile → site đã tạo → "Site Key" (dạng 0x4AAAAA...),
# và phải thêm hostname "localhost" vào danh sách Hostnames của site đó.
# Để trống = không render widget (BE sẽ trả CAPTCHA_REQUIRED nếu TURNSTILE_ENABLED=true)
# Test key dev (luôn pass, cần BE dùng secret test tương ứng): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
